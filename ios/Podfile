# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# iOS 15.5, not React Native's 15.1: `VisionCameraBarcodeScanner` (the recovery-key and transfer QR
# reader, 006 T012b / 025) declares `:ios => 15.5`, and CocoaPods refuses to resolve below it - which
# is how CI found this the first time iOS was ever built (2026-09-16). Taken as the HIGHER of the two
# so a future React Native bump raises this floor rather than silently lowering it.
platform :ios, [Gem::Version.new(min_ios_version_supported), Gem::Version.new('15.5')].max.to_s
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

use_modular_headers!

target 'ObalkaDatovaSchranka' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
